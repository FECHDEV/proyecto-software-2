# Java / Maven
target/
*.class
*.jar
!**/src/main/**/*.jar
!.mvn/wrapper/maven-wrapper.jar
# Imagenes subidas en desarrollo (TIENDA_IMAGENES_DIRECTORIO)
backend/datos/

# Node / Angular
node_modules/
dist/
.angular/
npm-debug.log*

# Material de proveedores (manuales en PDF): se consulta en local, no se versiona
referencias/

# Configuracion local con credenciales
application-local.properties
application-local.yml
.env
# Cualquier copia del .env (los scripts crean .env.tmp con todos los secretos) y llaves (revisión total,
# 26/10/2026); el ejemplo sí se versiona
.env.*
*.env
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*

# Logs
*.log

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Sistema operativo
Thumbs.db
Desktop.ini

# Skills de agentes (instalados localmente, no forman parte del sistema)
.agents/
.claude/skills/
.claude/agents/impeccable-*
# playwright-cli: configuración de cada máquina, capturas y sesiones
.playwright/
.playwright-cli/
.claude/settings.local.json
.superpowers/

# Documentación académica: se trabaja fuera del repositorio
/documentacion/
# Playwright CLI output (may contain credentials)
.playwright-cli/
