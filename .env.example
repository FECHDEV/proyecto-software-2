# Copiar a .env (ignorado por git) y completar. Nunca versionar el .env real.

# Contraseñas de MySQL: la de la aplicación y la del administrador de la base
TIENDA_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Clave de los tokens de sesión: base64 de al menos 256 bits. Para generarla:
#   openssl rand -base64 48
TIENDA_JWT_SECRETO=

# Administrador inicial: se crea en el primer arranque, si no hay ninguno
TIENDA_ADMIN_CORREO=
TIENDA_ADMIN_PASSWORD=

# Nombre del producto: firma los correos (en la interfaz está en frontend/src/app/core/marca.ts)
TIENDA_MARCA=Tienda Montero

# La dirección pública del sitio (por ejemplo https://midominio.com). Con nginx
# todo va por el mismo origen, así que solo hace falta si otro sitio llama a la API
TIENDA_CORS_ORIGENES=http://localhost

# Sistema de pago: simulador (por defecto) o el proveedor real, cuando esté su adaptador
TIENDA_PAGO_PROVEEDOR=simulador

# Puerto de la máquina donde se publica el sitio
TIENDA_PUERTO=80

# Correo: simulador (por defecto) solo escribe los correos en el registro de la
# API; smtp los envía por Gmail con la cuenta del proyecto
TIENDA_CORREO_PROVEEDOR=simulador
# La cuenta de Gmail del proyecto y su «contraseña de aplicación» (16 letras,
# se crea en https://myaccount.google.com/apppasswords con la verificación en
# dos pasos activa). Nunca la contraseña normal de la cuenta
TIENDA_CORREO_USUARIO=
TIENDA_CORREO_CONTRASENA=

# Dirección pública del sitio, para los enlaces de los correos (restablecer la
# contraseña). Con otro TIENDA_PUERTO, agregarlo: http://localhost:8080
TIENDA_SITIO_URL=http://localhost

# Solo en un servidor (docker-compose.nube.yml): el dominio del sitio
TIENDA_DOMINIO=
